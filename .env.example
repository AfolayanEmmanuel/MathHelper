# Copy this file to .env and fill in your values. Never commit .env.

# Server-only secrets (read by src/app/api routes, never bundled into the app)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# Optional, public: deployed API server URL for production native builds
# EXPO_PUBLIC_API_URL=https://your-app.expo.app
